{"file_spec":1.2,"file_creator":"Gami","file_title":"Sailboat","file_classes":["diagrams"],"gami:id":"sailboat","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#d8463b"}],"gami:about":{"blurb":"A white sail on a red hull, in five folds.","difficulty":1,"category":"object","minutes":3},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Fold up the hull","gami:text":"Start white side up. Fold the bottom edge up, about a sixth of the way, so the coloured side shows: the hull.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-1,0.35]},{"table":[1,0.35]}],"moving":{"table":[0,0.45]}}},"vertices_coords":[[-0.5,0,0.2],[0.5,0,0.2],[0.5,0,0.35],[-0.5,0,0.35],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[2,4,5,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,0.35],[-0.5,0.35],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Fold the top left behind","gami:text":"Fold the top left half behind, on a line from the left end of the hull’s top edge to the top right corner. That leaves a white sail.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-0.5,0.18999999999999995]},{"table":[0.5,-0.5]}],"moving":{"table":[-0.45,-0.45]}},"kind":"mountain"},"vertices_coords":[[-0.5,0,0.2],[0.5,0,0.2],[0.5,0,0.35],[-0.5,0,0.35],[0.5,0,-0.5],[0.145078247,0,0.43489601],[-0.5,0,0.19]],"faces_vertices":[[0,1,2,3],[4,5,6],[2,4,6,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,0.35],[-0.5,0.35],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.19]],"gami:faces_parent":[0,1,1],"gami:faces_layer":[2,0,1]},{"frame_title":"Tuck the point behind","gami:text":"Behind, the half you folded pokes out below the hull. Fold its point up behind, level with the bottom of the hull.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-1,0.35]},{"table":[1,0.35]}],"moving":{"table":[0.15,0.39999999999999997]}},"kind":"mountain","only":{"inPaper":[[[0.5,-0.5],[-0.5,-0.5],[-0.5,0.19]]]}},"vertices_coords":[[-0.5,0,0.2],[0.5,0,0.2],[0.5,0,0.35],[-0.5,0,0.35],[0.177307971,0,0.35],[0.145078247,0,0.26510399],[-0.078545524,0,0.35],[0.5,0,-0.5],[-0.5,0,0.19]],"faces_vertices":[[0,1,2,3],[4,5,6],[7,4,6,8],[2,7,8,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,0.35],[-0.5,0.35],[-0.409192029,-0.5],[-0.5,-0.5],[-0.5,-0.260803588],[0.5,-0.5],[-0.5,0.19]],"gami:faces_parent":[0,1,1,2],"gami:faces_layer":[3,0,1,2]},{"frame_title":"Shape the bow","gami:text":"Fold the hull’s left end behind at a slant, for the bow.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-0.5,0.19999999999999996]},{"table":[-0.38,0.35]}],"moving":{"table":[-0.49,0.33999999999999997]}},"kind":"mountain"},"vertices_coords":[[-0.5,0,0.2],[-0.38,0,0.35],[-0.353658537,0,0.232926829],[0.5,0,0.2],[0.5,0,0.35],[0.177307971,0,0.35],[0.145078247,0,0.26510399],[-0.078545524,0,0.35],[0.5,0,-0.5],[-0.5,0,0.19],[-0.5,0,0.2]],"faces_vertices":[[0,1,2],[0,3,4,1],[5,6,7],[8,5,7,9],[10,2,1],[4,8,9,10,1]],"gami:vertices_paper":[[-0.5,0.5],[-0.38,0.35],[-0.5,0.35],[0.5,0.5],[0.5,0.35],[-0.409192029,-0.5],[-0.5,-0.5],[-0.5,-0.260803588],[0.5,-0.5],[-0.5,0.19],[-0.5,0.2]],"gami:faces_parent":[0,0,1,2,3,3],"gami:faces_layer":[0,4,0,2,1,3]},{"frame_title":"Shape the stern","gami:text":"Fold the right end behind too, a little less. Ready to sail!","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[0.5,0.19999999999999996]},{"table":[0.43,0.35]}],"moving":{"table":[0.49,0.33999999999999997]}},"kind":"mountain"},"vertices_coords":[[-0.5,0,0.2],[-0.38,0,0.35],[-0.353658537,0,0.232926829],[0.5,0,0.2],[0.385036496,0,0.296350365],[0.43,0,0.35],[0.177307971,0,0.35],[0.145078247,0,0.26510399],[-0.078545524,0,0.35],[0.5,0,-0.5],[-0.5,0,0.19],[-0.5,0,0.2],[0.5,0,0.2]],"faces_vertices":[[0,1,2],[3,4,5],[0,3,5,1],[6,7,8],[9,6,8,10]