{"file_spec":1.2,"file_creator":"Gami","file_title":"Frog bookmark","file_classes":["diagrams"],"gami:id":"frog-bookmark","gami:sheets":[{"size":[1,1],"front":"#3f8f3a","back":"#8fd16a"}],"gami:about":{"blurb":"A frog’s head with eyes that stick out, slipped over the corner of a page.","difficulty":1,"category":"object","minutes":5},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Start as a diamond","gami:text":"Start dark side up, with a corner pointing towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Fold the bottom corner up to the top corner, making a triangle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0.5]},{"paper":[0.5,-0.5]}]}},"vertices_coords":[[0,0,-0.707106781],[0.707106781,0,0],[-0.707106781,0,0],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[1,3,2]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Fold the top layer down","gami:text":"Fold the top layer’s point down to the middle of the bottom edge. This makes the pocket.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0.5]},{"table":[0,0]}]},"layers":1},"vertices_coords":[[0,0,0],[0.353553391,0,-0.353553391],[-0.353553391,0,-0.353553391],[0.707106781,0,0],[-0.707106781,0,0],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[1,3,4,2],[3,5,4]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[-0.5,0],[0.5,0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0,1],"gami:faces_layer":[2,1,0]},{"frame_title":"Fold