{"file_spec":1.2,"file_creator":"Gami","file_title":"Easy sword","file_classes":["diagrams"],"gami:id":"easy-sword","gami:sheets":[{"size":[1,1],"front":"#2d3f8a","back":"#b9c2d6"}],"gami:about":{"blurb":"A silver sword with a crossguard and a short handle, from one square.","difficulty":1,"category":"toy","minutes":5},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Start as a diamond","gami:text":"Start dark side up, with a corner pointing towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Crease down the middle","gami:text":"Fold the left corner to the right corner, and unfold.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"table":[-0.7071067811865476,0]},{"table":[0.7071067811865476,0]}]}},"vertices_coords":[[0,0,0.707106781],[0,0,-0.707106781],[0.707106781,0,0],[0.707106781,0,0]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it back up, leaving a crease.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0.707106781],[0,0,-0.707106781],[-0.707106781,0,0],[0.707106781,0,0]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Fold a kite","gami:text":"Fold the upper edges to the middle crease, making a kite with a long point at the top.","gami:kind":"fold","gami:op":{"op":"together","ops":[{"op":"fold","line":{"edgeOnto":[[{"table