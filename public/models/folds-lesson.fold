{"file_spec":1.2,"file_creator":"Gami","file_title":"Common folds","file_classes":["diagrams"],"gami:id":"folds-lesson","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#7fb3d5"}],"gami:about":{"blurb":"Valley and mountain, reverse, squash, rabbit ear, pleat, crimp and petal folds, each on its own square.","difficulty":2,"category":"lesson","minutes":20},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Valley fold","gami:text":"Nearly every fold is a valley fold or a mountain fold. For a valley fold, fold the paper towards you: bring the bottom edge up to the top edge.","gami:kind":"fold","gami:section":"Valley and mountain folds","gami:op":{"op":"fold","line":{"onto":[{"paper":[0,0.5]},{"paper":[0,-0.5]}]}},"vertices_coords":[[-0.5,0,-0.5],[0.5,0,-0.5],[0.5,0,0],[-0.5,0,0],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[2,4,5,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,0],[-0.5,0],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it. The crease dips down into the paper, like a valley.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,0],[-0.5,0,0],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[2,4,5,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,0],[-0.5,0],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Mountain fold","gami:text":"Now fold the left half behind, away from you, onto the back of the right half. This is a mountain fold.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[0,-1]},{"table":[0,1]}],"moving":{"table":[-0.3,0]}},"kind":"mountain"},"vertices_coords":[[0.5,0,0.5],[0,0,0.5],[0,0,0],[0.5,0,0],[0.5,0,0.5],[0.5,0,0],[0,0,-0.5],[0.5,0,-0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2],[6,7,3,2],[5,8,6,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,0],[-0.5,0],[0.5,0.5],[0.5,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[0,1,0,1]},{"frame_title":"Open it up","gami:text":"Open it. This crease stands up like a ridge. Turn the paper over and it would look like a valley: a mountain fold is just a valley fold seen from the other side.","gami:kind":"unfold","gami:op":{"op":"unfold","to":0},"vertices_coords":[[-0.5,0,0.5],[0,0,0.5],[0,0,0],[-0.5,0,0],[0.5,0,0.5],[0.5,0,0],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2],[6,7,3,2],[5,8,6,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,0],[-0.5,0],[0.5,0.5],[0.5,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,0,0,0]},{"frame_title":"Inside reverse fold","gami:text":"An inside reverse fold turns a point back on itself, tucking it in between its own layers. It makes necks, heads, tails and legs.","gami:kind":"assemble","gami:section":"Inside reverse fold","gami:op":{"op":"newSheet"},"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0]},{"frame_title":"Make a diamond","gami:text":"Turn the square so a corner points towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Fold the bottom corner up to the top corner. It’s a triangle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0.5]},{"paper":[0.5,-0.5]}]}},"vertices_coords":[[0,0,-0.707106781],[0.707106781,0,0],[-0.707106781,0,0],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[1,3,2]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Crease the point","gami:text":"Fold the right point up along a slanting line, through both layers, and crease it well.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[0.3,0]},{"table":[1.1191520442889917,-0.573576436351046]}],"moving":{"table":[0.6571067811865475,0]}}},"vertices_coords":[[0.539445345,0,-0.167661436],[0.43923872,0,-0.382555238],[0.3,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.539445345,0,-0.167661436],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[0.262890924,0.5],[0.5,0.5],[0.212132034,0.212132034],[-0.5,0.5],[-0.5,-0.5],[0.5,0.262890924],[0.5,-0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[2,1,3,0]},{"frame_title":"Unfold","gami:text":"Fold it back down. The crease shows where the reverse fold goes.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0.539445345,0,-0.167661436],[0.707106781,0,0],[0.3,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.539445345,0,-0.167661436],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[0.262890924,0.5],[0.5,0.5],[0.212132034,0.212132034],[-0.5,0.5],[-0.5,-0.5],[0.5,0.262890924],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[1,1,0,0]},{"frame_title":"Inside reverse fold","gami:text":"Open the layers a little and push the point up between them along the crease, so it turns back on itself. Flatten it.","gami:kind":"reverse","gami:op":{"op":"collapse","creases":[{"line":{"through":[{"table":[0.3,0]},{"table":[1.1191520442889917,-0.573576436351046]}]},"kind":"inside"}],"anchor":{"paper":[-0.3,0.3]}},"vertices_coords":[[0.539445345,0,-0.167661436],[0.43923872,0,-0.382555238],[0.3,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.539445345,0,-0.167661436],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[0.262890924,0.5],[0.5,0.5],[0.212132034,0.212132034],[-0.5,0.5],[-0.5,-0.5],[0.5,0.262890924],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,3,1,2]},{"frame_title":"Open it up","gami:text":"Open it out to see the creases: the reverse fold left a pair of creases, mirrored across the middle one.","gami:kind":"unfold","gami:via":[{"vertices_coords":[[0.539445345,0,-0.167661436],[0.707106781,0,0],[0.3,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.539445345,0,-0.167661436],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[0.262890924,0.5],[0.5,0.5],[0.212132034,0.212132034],[-0.5,0.5],[-0.5,-0.5],[0.5,0.262890924],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[1,1,0,0]},{"vertices_coords":[[0.539445345,0,0.167661436],[0.707106781,0,0],[0.3,0,0],[0,0,0.707106781],[-0.707106781,0,0],[0.539445345,0,-0.167661436],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[0.262890924,0.5],[0.5,0.5],[0.212132034,0.212132034],[-0.5,0.5],[-0.5,-0.5],[0.5,0.262890924],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,0,0,0]}],"gami:op":{"op":"unfold","to":5},"vertices_coords":[[0.262890924,0,0.5],[0.5,0,0.5],[0.212132034,0,0.212132034],[-0.5,0,0.5],[-0.5,0,-0.5],[0.5,0,0.262890924],[0.5,0,-0.5]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[0.262890924,0.5],[0.5,0.5],[0.212132034,0.212132034],[-0.5,0.5],[-0.5,-0.5],[0.5,0.262890924],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,0,0,0]},{"frame_title":"Outside reverse fold","gami:text":"An outside reverse fold also turns a point back, but this time the paper wraps round the outside of the point instead of going inside it. It often makes heads that hang down.","gami:kind":"assemble","gami:section":"Outside reverse fold","gami:op":{"op":"newSheet"},"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[1]},{"frame_title":"Make a diamond","gami:text":"Turn the square so a corner points towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Fold the bottom corner up to the top corner. It’s a triangle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0.5]},{"paper":[0.5,-0.5]}]}},"vertices_coords":[[0,0,-0.707106781],[0.707106781,0,0],[-0.707106781,0,0],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[1,3,2]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Crease the point","gami:text":"Fold the right point back over the triangle along a line leaning to the left, through both layers, and crease it well.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[0.5,0]},{"table":[2.220446049250313e-16,-0.8660254037844387]}],"moving":{"table":[0.6571067811865475,0]}}},"vertices_coords":[[0.217086876,0,-0.490019906],[0.396446609,0,0.179359734],[0.5,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.217086876,0,-0.490019906],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[-0.192992796,0.5],[0.5,0.5],[0.353553391,0.353553391],[-0.5,0.5],[-0.5,-0.5],[0.5,-0.192992796],[0.5,-0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[2,1,3,0]},{"frame_title":"Unfold","gami:text":"Fold it back again.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0.217086876,0,-0.490019906],[0.707106781,0,0],[0.5,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.217086876,0,-0.490019906],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[-0.192992796,0.5],[0.5,0.5],[0.353553391,0.353553391],[-0.5,0.5],[-0.5,-0.5],[0.5,-0.192992796],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[1,1,0,0]},{"frame_title":"Outside reverse fold","gami:text":"Open the point’s layers and wrap them round the outside of the triangle, so the point turns down past the folded bottom edge. Flatten it.","gami:kind":"reverse","gami:op":{"op":"collapse","creases":[{"line":{"through":[{"table":[0.5,0]},{"table":[2.220446049250313e-16,-0.8660254037844387]}]},"kind":"outside"}],"anchor":{"paper":[-0.3,0.3]}},"vertices_coords":[[0.217086876,0,-0.490019906],[0.396446609,0,0.179359734],[0.5,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.217086876,0,-0.490019906],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[-0.192992796,0.5],[0.5,0.5],[0.353553391,0.353553391],[-0.5,0.5],[-0.5,-0.5],[0.5,-0.192992796],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[2,1,3,0]},{"frame_title":"Open it up","gami:text":"Open it out. Again a mirrored pair of creases, but folded the opposite way to the inside reverse fold’s.","gami:kind":"unfold","gami:via":[{"vertices_coords":[[0.217086876,0,-0.490019906],[0.707106781,0,0],[0.5,0,0],[0,0,-0.707106781],[-0.707106781,0,0],[0.217086876,0,-0.490019906],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[-0.192992796,0.5],[0.5,0.5],[0.353553391,0.353553391],[-0.5,0.5],[-0.5,-0.5],[0.5,-0.192992796],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[1,1,0,0]},{"vertices_coords":[[0.217086876,0,0.490019906],[0.707106781,0,0],[0.5,0,0],[0,0,0.707106781],[-0.707106781,0,0],[0.217086876,0,-0.490019906],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[1,5,2],[5,6,4,2]],"gami:vertices_paper":[[-0.192992796,0.5],[0.5,0.5],[0.353553391,0.353553391],[-0.5,0.5],[-0.5,-0.5],[0.5,-0.192992