{"file_spec":1.2,"file_creator":"Gami","file_title":"Origami bases","file_classes":["diagrams"],"gami:id":"bases-lesson","gami:sheets":[{"size":[1,1],"front":"#3f8fd2","back":"#f6f3ec"}],"gami:about":{"blurb":"The kite, square, water bomb, bird, fish and frog bases: where most models start.","difficulty":2,"category":"lesson","minutes":30},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Make a diamond","gami:text":"A base is a simple shape that many models start from. The kite base is the simplest: two edges folded to a diagonal. The swan and the fox start from it. Begin by turning the square so a corner points at you.","gami:kind":"rotate","gami:section":"Kite base","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Crease down the middle","gami:text":"Fold the left corner to the right corner, and unfold.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"table":[-0.7071067811865476,0]},{"table":[0.7071067811865476,0]}]}},"vertices_coords":[[0,0,0.707106781],[0,0,-0.707106781],[0.707106781,0,0],[0.707106781,0,0]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it back up, leaving a crease.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0.707106781],[0,0,-0.707106781],[-0.707106781,0,0],[0.707106781,0,0]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Fold a kite","gami:text":"Fold the lower left edge to the centre crease.","gami:kind":"fold","gami:op":{"op":"fold","line":{"edgeOnto":[[{"table":[0,0.7071067811865476]},{"table":[-0.7071067811865476,0]}],[{"table":[0,0.7071067811865476]},{"table":[0,-0.7071067811865476]}]]}},"vertices_coords":[[0,0,0.707106781],[-0.414213562,0,-0.292893219],[0,0,-0.292893219],[0,0,-0.707106781],[0.707106781,0,0]],"faces_vertices":[[0,1,2],[0,3,1],[0,4,3]],"gami:vertices_paper":[[-0.5,0.5],[-0.085786438,-0.5],[-0.5,-0.5],[0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0,1],"gami:faces_layer":[1,0,0]},{"frame_title":"Fold the other side","gami:text":"And the lower right edge. It’s a kite.","gami:kind":"fold","gami:op":{"op":"fold","line":{"edgeOnto":[[{"table":[0,0.7071067811865476]},{"table":[0.7071067811865476,0]}],[{"table":[0,0.7071067811865476]},{"table":[0,-0.7071067811865476]}]]}},"vertices_coords":[[0,0,0.707106781],[-0.414213562,0,-0.292893219],[0,0,-0.292893219],[0,0,-0.707106781],[0,0,-0.292893219],[0.414213562,0,-0.292893219]],"faces_vertices":[[0,1,2],[0,3,1],[0,4,5],[0,5,3]],"gami:vertices_paper":[[-0.5,0.5],[-0.085786438,-0.5],[-0.5,-0.5],[0.5,-0.5],[0.5,0.5],[0.5,0.085786438]],"gami:faces_parent":[0,1,2,2],"gami:faces_layer":[1,0,1,0]},{"frame_title":"Open it out","gami:text":"Open the paper out flat. Each base leaves its own pattern of creases.","gami:kind":"unfold","gami:via":[{"vertices_coords":[[0,0,0.707106781],[-0.414213562,0,-0.292893219],[0,0,-0.292893219],[0,0,-0.707106781],[0.707106781,0,0],[0.414213562,0,-0.292893219]],"faces_vertices":[[0,1,2],[0,3,1],[0,4,5],[0,5,3]],"gami:vertices_paper":[[-0.5,0.5],[-0.085786438,-0.5],[-0.5,-0.5],[0.5,-0.5],[0.5,0.5],[0.5,0.085786438]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[1,0,0,0]},{"vertices_coords":[[0,0,0.707106781],[-0.414213562,0,-0.292893219],[-0.707106781,0,0],[0,0,-0.707106781],[0.707106781,0,0],[0.414213562,0,-0.292893219]],"faces_vertices":[[0,1,2],[0,3,1],[0,4,5],[0,5,3]],"gami:vertices_paper":[[-0.5,0.5],[-0.0