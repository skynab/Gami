es_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it back up, leaving a crease.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Fold the other diagonal","gami:text":"The two creases cross at the centre.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[0.5,-0.5]},{"paper":[-0.5,0.5]}]}},"vertices_coords":[[0,0,0],[-0.5,0,0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2],[4,1,0],[3,4,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[0.5,0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[1,0,1,0]},{"frame_title":"Unfold","gami:text":"Open it back up, leaving a crease.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2],[4,1,0],[3,4,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[0.5,0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,0,0,0]},{"frame_title":"Fold in half","gami:text":"Edge to edge this time, then unfold.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0]},{"paper":[0.5,0]}]}},"vertices_coords":[[0,0,0],[0,0,-0.5],[0.5,0,-0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0.5],[0,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1],[4,0,2],[5,3,0],[4,6,0],[6,5,0]],"gami:vertices_paper":[[0,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5],[-0.5,0.5],[0.5,0.5],[0,0.5]],"gami:faces_parent":[0,0,1,2,3,3],"gami:faces_layer":[1,0,1,0,1,0]},{"frame_title":"Unfold","gami:text":"Open it back up, leaving a crease.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0],[0,0,-