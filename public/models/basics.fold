{"file_spec":1.2,"file_creator":"Gami","file_title":"Folding basics","file_classes":["diagrams"],"gami:id":"basics","gami:sheets":[{"size":[1,1],"front":"#5b54e8","back":"#f6f3ec"}],"gami:about":{"blurb":"Start here: fold, unfold and turn the paper over.","difficulty":1,"category":"lesson","minutes":2},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Fold in half diagonally","gami:text":"Bring the top-left corner down to meet the bottom-right corner, then press the crease flat.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,-0.5]},{"paper":[0.5,0.5]}]}},"vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open the paper back up. The diagonal crease stays as a guide for later.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Turn over","gami:text":"Flip the paper from left to right, so the white side faces up.","gami:kind":"turn-over","gami:op":{"op":"turnOver"},"vertices_coords":[[0.5,0,0.5],[-0.5,0,-0.5],[0.5,0,-0.5],[-0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Fold in half","gami:text":"Bring the bottom edge up to the top edge and crease. The fold crosses the diagonal at the centre.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[0,0.5]},{"paper":[0,-0.5]}]}},"vertices_coords":[[0.5,0,-0.5],[0,0,0],[0.5,0,0],[-0.5,0,-0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0]],"faces_vertices":[[0,1,2],[1,3,4,2],[0,5,6,1],[6,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0,0],[-0.5,0],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,0]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[1,0,1,0]}]}
