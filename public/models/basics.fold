{"file_spec":1.2,"file_creator":"Gami","file_title":"Basics","file_classes":["diagrams"],"gami:id":"basics","gami:sheets":[{"size":[1,1],"front":"#5b54e8","back":"#f6f3ec"}],"gami:about":{"blurb":"Start here: how to step through, play, turn and read each fold.","difficulty":1,"category":"lesson","minutes":5},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Welcome to Gami","gami:text":"Each step shows one fold. Press Next step (›) or → to go on.","gami:kind":"fold","gami:section":"Stepping through","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,-0.5]},{"paper":[0.5,0.5]}]}},"vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Going back","gami:text":"Previous step (‹) or ← goes back, all the way to the flat sheet before the first fold.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Watch it again","gami:text":"Replay (R) plays this step again. Play half a step (H) stops halfway, so you can see how the paper moves.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[0.5,-0.5]},{"paper":[-0.5,0.5]}]}},"vertices_coords":[[0,0,0],[-0.5,0,0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2],[4,1,0],[3,4,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[0.5,0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[1,0,1,0]},{"frame_title":"Play by itself","gami:text":"Press and hold Next step to play on through the steps. Press it again, press Space or click the model to pause.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2],[4,1,0],[3,4,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[0.5,0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,0,0,0]},{"frame_title":"Speed","gami:text":"The 1× button (S) changes how fast the paper folds.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[0,0.5]},{"paper":[0,-0.5]}]}},"vertices_coords":[[0,0,0],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0],[0.5,0,-0.5],[0.5,0,0]],"faces_vertices":[[0,1,2],[3,0,4],[0,2,4],[5,6,0],[6,1,0],[3,5,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0]],"gami:faces_parent":[0,1,1,2,2,3],"gami:faces_layer":[0,1,0,1,0,1]},{"frame_title":"Sections","gami:text":"Purple diamonds on the bar mark where each part starts, like this one. Click one to jump there.","gami:kind":"unfold","gami:section":"Finding your way","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[-0.5,0,0],[0.5,0,0.5],[0.5,0,0]],"faces_vertices":[[0,1,2],[3,0,4],[0,2,4],[5,6,0],[6,1,0],[3,5,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0]],"gami:faces_parent":[0,1,2,3,4,5],"gami:faces_layer":[0,0,0,0,0,0]},{"frame_title":"The progress bar","gami:text":"Drag along the bar to move the paper by hand, as slowly as you like. Each tick is a step.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0]},{"paper":[0.5,0]}]}},"vertices_coords":[[0,0,0],[0,0,-0.5],[0.5,0,-0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0],[0.5,0,0.5],[0.5,0,0],[0,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1],[4,0,5],[0,2,5],[6,7,0],[7,3,0],[4,8,0],[8,6,0]],"gami:vertices_paper":[[0,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0],[0,0.5]],"gami:faces_parent":[0,0,1,2,3,4,5,5],"gami:faces_layer":[1,0,1,1,0,0,1,0]},{"frame_title":"Back to the first step","gami:text":"Press and hold First step (⏮) until it fills up to go back to step 1. A quick tap does nothing, so you can’t lose your place by accident.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,-0.5],[-0.5,0,0.5],[-0.5,0,0],[0.5,0,0.5],[0.5,0,0],[0,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1],[4,0,5],[0,2,5],[6,7,0],[7,3,0],[4,8,0],[8,6,0]],"gami:vertices_paper":[[0,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0],[0,0.5]],"gami:faces_parent":[0,1,2,3,4,5,6,7],"gami:faces_layer":[0,0,0,0,0,0,0,0]},{"frame_title":"Turn over","gami:text":"Drag the model to turn it. Scroll or pinch to zoom, and right-drag or drag with two fingers to move it.","gami:kind":"turn-over","gami:section":"Looking around","gami:op":{"op":"turnOver"},"vertices_coords":[[0,0,0],[0,0,-0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0],[-0.5,0,0.5],[-0.5,0,0],[0,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1],[4,0,5],[0,2,5],[6,7,0],[7,3,0],[4,8,0],[8,6,0]],"gami:vertices_paper":[[0,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0],[0,0.5]],"gami:faces_parent":[0,1,2,3,4,5,6,7],"gami:faces_layer":[0,0,0,0,0,0,0,0]},{"frame_title":"Set views","gami:text":"Free, Top, Front and Side (1 to 4) look from set angles. On a phone they’re behind the ⋯ button.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0],[-0.353553391,0,-0.353553391],[0,0,-0.707106781],[-0.707106781,0,0],[0.707106781,0,0],[0.353553391,0,-0.353553391],[0,0,0.707106781],[-0.353553391,0,0.353553391],[0.353553391,0,0.353553391]],"faces_vertices":[[0,1,2],[0,3,1],[4,0,5],[0,2,5],[6,7,0],[7,3,0],[4,8,0],[8,6,0]],"gami:vertices_paper":[[0,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0],[0,0.5]],"gami:faces_parent":[0,1,2,3,4,5,6,7],"gami:faces_layer":[0,0,0,0,0,0,0,0]},{"frame_title":"The view cube","gami:text":"Click a face, edge or corner of the cube in the top right to look from there. Hold it down to make it bigger and easier to pick.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,-0.5]},{"paper":[0,0]}]}},"vertices_coords":[[-0.353553391,0,-0.353553391],[0,0,0],[0,0,-0.353553391],[0,0,0],[-0.707106781,0,0],[0.707106781,0,0],[0.353553391,0,-0.353553391],[0,0,0.707106781],[-0.353553391,0,0.353553391],[0.353553391,0,0.353553391]],"faces_vertices":[[0,1,2],[3,0,2],[3,4,0],[5,3,6],[2,1,6],[3,2,6],[7,8,3],[8,4,3],[5,9,3],[9,7,3]],"gami:vertices_paper":[[0,-0.5],[-0.5,-0.5],[-0.25,-0.25],[0,0],[0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0],[0,0.5]],"gami:faces_parent":[0,0,1,2,3,3,4,5,6,7],"gami:faces_layer":[1,0,0,0,1,0,0,0,0,0]},{"frame_title":"Lock and reset","gami:text":"Lock view (L) holds the angle still, so dragging moves the paper instead. Reset view (0) puts the camera back.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[0.5,0.5]},{"paper":[0,0]}]}},"vertices_coords":[[-0.353553391,0,-0.353553391],[0,0,0],[0,0,-0.353553391],[0,0,0],[-0.707106781,0,0],[0.707106781,0,0],[0.353553391,0,-0.353553391],[0,0,0],[-0.353553391,0,0.353553391],[0,0,0.353553391],[0.353553391,0,0.353553391]],"faces_vertices":[[0,1,2],[3,0,2],[3,4,0],[5,3,6],[2,1,6],[3,2,6],[7,8,9],[8,3,9],[8,4,3],[5,10,3],[10,7,9],[10,9,3]],"gami:vertices_paper":[[0,-0.5],[-0.5,-0.5],[-0.25,-0.25],[0,0],[0.5,-0.5],[-0.5,0.5],[-0.5,0],[0.5,0.5],[0.5,0],[0.25,0.25],[0,0.5]],"gami:faces_parent":[0,1,2,3,4,5,6,6,7,8,9,9],"gami:faces_layer":[1,0,0,0,1,0,1,0,0,0,1,0]},{"frame_title":"Fold lines and arrows","gami:text":"A dashed line is a valley fold, a dotted one a mountain fold, and the arrow shows where the paper goes. The button on this card (G) hides them.","gami:kind":"fold","gami:section":"Reading the steps","gami:op":{"op":"fold","line":{"onto":[{"paper":[0.5,-0.5]},{"paper":[0,0]}]}},"vertices_coords":[[-0.353553391,0,-0.353553391],[0,0