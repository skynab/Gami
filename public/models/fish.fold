{"file_spec":1.2,"file_creator":"Gami","file_title":"Fish","file_classes":["diagrams"],"gami:id":"fish","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#2f8fbf"}],"gami:about":{"blurb":"A very easy fish, all triangles.","difficulty":1,"category":"animal","minutes":3},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Start as a diamond","gami:text":"Start white side up, with a corner pointing towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Fold the top corner down onto the bottom corner, making a triangle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"table":[0,-0.7071067811865476]},{"table":[0,0.7071067811865476]}]}},"vertices_coords":[[0.707106781,0,0],[0,0,0.707106781],[-0.707106781,0,0],[0,0,0.707106781]],"faces_vertices":[[0,1,2],[3,0,2]],"gami:vertices_paper":[[0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Fold the top point up","gami:text":"Fold the bottom point of the top layer up, so it pokes out a little above the long edge.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"table":[0,0.7071067811865476]},{"table":[0,-0.14142135623730945]}]},"layers":1},"vertices_coords":[[0.424264069,0,0.282842712],[0,0,-0.141421356],[-0.424264069,0,0.282842712],[0.707106781,0,0],[-0.707106781,0,0],[0,0,0.707106781]],"faces_vertices":[[0,1,2],[3,0,2,4],[5,3,4]],"gami:vertices_paper":[[0.5,0.1],[0.5,-0.5],[-0.1,-0.5],[0.5,0.5],[-0.5,-0.5],[-0.5,0.5]],"gami:faces_parent":[0,0,1],"gami:faces_layer":[2,1,0]},{"frame_title":"Fold the lower edge up","gami:text":"Fold the lower left edge up onto the crease you just made.","gami:kind":"fold","gami:op":{"op":"fold","line":{"edgeOnto":[[{"table":[-0.4242640687119285,0.28284271247461906]},{"table":[0,0.7071067811865476]}],[{"table":[-0.4242640687119285,0.28284271247461906]},{"table":[0.4242640687119285,0.28284271247461906]}]]}},"vertices_coords":[[0.424264069,0,0.282842712],[0,0,-0.141421356],[-0.424264069,0,0.282842712],[0.707106781,0,0],[-0.707106781,0,0],[0.175735931,0,0.282842712],[0.175735931,0,0.53137085],[-0.424264069,0,0.282842712]],"faces_vertices":[[0,1,2],[3,0,2,4],[5,6,7],[6,3,4,7]],"gami:vertices_paper":[[0.5,0.1],[0.5,-0.5],[-0.1,-0.5],[0.5,0.5],[-0.5,-0.5],[-0.5,0.5],[-0.251471863,0.5],[-0.5,-0.1]],"gami:faces_parent":[0,1,2,2],"gami:faces_layer":[2,1,1,0]},{"frame_title":"Fold the flap back down","gami:text":"Fold most of that flap back down again, a little above its crease, so it sticks out underneath.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-0.4242640687119285,0.28284271247461906]},{"table":[-0.134486320825208,0.3604884260053753]}],"moving":{"table":[-0.22597509643716643,0.30894795091862937]}},"only":{"inPaper":[[[-0.5,0.5],[-0.251471863,0.5],[-0.5,-0.1]]]}},"vertices_coords":[[0.424264069,0,0.282842712],[0,0,-0.141421356],[-0.424264069,0,0.282842712],[0.707106781,0,0],[-0.707106781,0,0],[0.095351174,0,0.582842712],[0.175735931,0,0.443612228],[-0.424264069,0,0.282842712],[0.175735931,0,0.53137085]],"faces_vertices":[[0,1,2],[3,0,2,4],[5,6,7],[6,8,7],[8,3,4,7]],"gami:vertices_paper":[[0.5,0.1],[0.5,-0.5],[-0.1,-0.5],[0.5,0.5],[-0.5,-0.5],[-0.5,0.5],[-0.339230485,0.5],[-0.5,-0.1],[-0.251471863,0.5]],"gami:faces_parent":[0,1,2,2,3],"gami:faces_layer":[2,1,2,1,0]},{"frame_title":"Fold the left corner up","gami:text":"Fold the left corner over to the right so it points straight up. This makes the tail.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-0.4242640687119285,0.28284271247461906]},{"table":[-0.5390690984214555,0.00567885272123303]}],"moving":{"table":[-0.6871067811865476,0.01]}}},"vertices_coords":[[0.424264069,0,0.282842712],[0,0,-0.141421356],[-0.424264069,0,0.282842712],[-0.424264069,0,-0.117157288],[-0.541421356,0,0],[0.707106781,0,0],[0.095351174,0,0.582842712],[0.175735931,0,0.443612228],[-0.424264069,0,0.282842712],[0.175735931,0,0.53137085]],"faces_vertices":[[0,1,2],[2,3,4],[5,0,2,4],[6,7,8],[7,9,8],[4,3,8],[9,5,4,8]],"gami:vertices_paper":[[0.5,0.1],[0.5,-0.5],[-0.1,-0.5],[-0.5,-0.5],[-0.382842712,-0.382842712],[0.5,0.5],[-0.5,0.5],[-0.339230485,0.5],[-0.5,-0.1],[-0.251471863,0.5]],"gami:faces_parent":[0,1,1,2,3,4,4],"gami:faces_layer":[2,2,1,2,1,3,0]},{"frame_title":"Fold the tail’s tip to the left","gami:text":"Fold the top of the tail back over to the left. How far sets the size of the tail.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-0.5414213562373095,0]},{"table":[-0.4242640687119285,0.08284271247461905]}],"moving":{"table":[-0.4242640687119285,-0.09715728752538096]}},"only":{"inPaper":[[[-0.1,-0.5],[-0.5,-0.5],[-0.382842712,-0.382842712]],[[-0.382842712,-0.382842712],[-0.5,-0.5],[-0.5,-0.1]]]}},"vertices_coords":[[0.424264069,0,0.282842712],[0,0,-0.141421356],[-0.424264069,0,0.282842712],[-0.424264069,0,0.082842712],[-0.612825877,0,0.149509379],[-0.541421356,0,0],[0.707106781,0,0],[0.095351174,0,0.582842712],[0.175735931,0,0.443612228],[-0.424264069,0,0.282842712],[0.175735931,0,0.53137085],[-0.424264069,0,0.082842712]],"faces_vertices":[[0,1,2],[3,4,5],[2,3,5],[6,0,2,5],[7,8,9],[8,10,9],[5,4,11],[5,11,9],[10,6,5,9]],"gami:vertices_paper":[[0.5,0.1],[0.5,-0.5],[-0.1,-0.5],[-0.3,-0.5],[-0.5,-0.5],[-0.382842712,-0.382842712],[0.5,0.5],[-0.5,0.5],[-0.339230485,0.5],[-0.5,-0.1],[-0.251471863,0.5],[-0.5,-0.3]],"gami:faces_parent":[0,1,1,2,3,4,5,5,6],"gami:faces_layer":[2,5,2,1,2,1,4,3,0]},{"frame_title":"Turn over","gami:text":"Turn the fish over from left to right.","gami:kind":