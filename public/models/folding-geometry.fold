{"file_spec":1.2,"file_creator":"Gami","file_title":"Geometry by folding","file_classes":["diagrams"],"gami:id":"folding-geometry","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#c9b8f0"}],"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"A line through two points","gami:text":"Axiom 1: through any two points there is exactly one fold. Fold through two corners. Folding draws straight lines, like a ruler.","gami:kind":"fold","gami:section":"Axiom 1","vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it again. Each fold leaves a crease, a straight line.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"A fresh square","gami:text":"Put the creased square aside and take a new one, so the next creases stand out.","gami:kind":"assemble","gami:section":"Axiom 2","vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0]},{"frame_title":"One point onto another","gami:text":"Axiom 2: there is exactly one fold that lays one point on another. Every point of the crease is the same distance from both: it’s the perpendicular bisector.","gami:kind":"fold","vertices_coords":[[0.5,0,0.5],[0,0,0.5],[0,0,-0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it. The crease cuts the square exactly in half.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0,0,0.5],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"A fresh square","gami:text":"Put the creased square aside and take a new one, so the next creases stand out.","gami:kind":"assemble","gami:section":"Axiom 3","vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0]},{"frame_title":"A diagonal","gami:text":"Fold a diagonal, from the bottom right corner to the top left.","gami:kind":"fold","vertices_coords":[[0.5,0,0.5],[-0.5,0,0.5],[-0.5,0,-0.5],[-0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2]],"gami:vertices_paper":[[0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it. This crease is one of the lines.","gami:kind":"unfold","vertices_coords":[[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2]],"gami:vertices_paper":[[0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"One line onto another","gami:text":"Axiom 3: fold one line onto another. The crease halves the angle between them: the bottom edge onto the diagonal halves 45° into 22.5°.","gami:kind":"fold","vertices_coords":[[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.207106781,0,-0.207106781],[-0.5,0,0.085786438]],"faces_vertices":[[0,1,2],[3,0,4],[0,2,4]],"gami:vertices_paper":[[0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[-0.5,0.085786438]],"gami:faces_parent":[0,1,1],"gami:faces_layer":[0,1,0]},{"frame_title":"Unfold","gami:text":"Open it. Halving angles is as easy as halving lengths.","gami:kind":"unfold","vertices_coords":[[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[-0.5,0,0.085786438]],"faces_vertices":[[0,1,2],[3,0,4],[0,2,4]],"gami:vertices_paper":[[0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[-0.5,0.085786438]],"gami:faces_parent":[0,1,2],"gami:faces_layer":[0,0,0]},{"frame_title":"A fresh square","gami:text":"Put the creased square aside and take a new one, so the next creases stand out.","gami:kind":"assemble","gami:section":"Axiom 4","vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0]},{"frame_title":"A diagonal","gami:text":"Fold a diagonal, from the bottom left corner to the top right.","gami:kind":"fold","vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it. This crease is the given line.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Square to a line, through a point","gami:text":"Axiom 4: through any point there is exactly one fold square to a given line. Fold through the centre at right angles to the diagonal.","gami:kind":"fold","vertices_coords":[[0,0,0],[-0.5,0,0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2],[4,1,0],[3,4,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[0.5,0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[1,0,1,0]},{"frame_title":"Unfold","gami:text":"Open it. The two diagonals cross at right angles.","gami:kind":"unfold","vertices_coords":[[0,0,0],[0.5,0,-0.5],[-0.5,0,-0.5],[-0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[3,0,2],[4,1,0],[3,4,0]],"gami:vertices_paper":[[0,0],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5],[0.5,0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,0,0,0]},{"frame_title":"A fresh square","gami:text":"Put the creased square aside and take a new one, so the next creases stand out.","gami:kind":"assemble","gami:section":"Axiom 5","vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0]},{"frame_title":"Fold in half","gami:text":"Fold the left edge onto the right edge.","gami:kind":"fold","vertices_coords":[[0.5,0,0.5],[0,0,0.5],[0,0,-0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it: a crease down the middle.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0,0,0.5],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"A point onto a line, through a point","gami:text":"Axiom 5: fold the bottom left corner onto the middle crease, with the fold through the bottom right corner. The corner, the fold’s end and where it lands make an equilateral triangle: you’ve folded 60°.","gami:kind":"fold","vertices_coords":[[0,0,-0.366025404],[0.25,0,0.066987298],[0,0,0.211324865],[-0.5,0,-0.077350269],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[2,4,5,3],[1,6,2],[6,7,4,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,0.211324865],[-0.5,-0.077350269],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[1,0,1,0]},{"frame_title":"Unfold","gami:text":"Open it. Straightedge and compass can do this too; folding is just quicker.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0,0,0.5],[0,0,0.211324865],[-0.5,0,-0.077350269],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[2,4,5,3],[1,6,2],[6,7,4,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,0.211324865],[-0.5,-0.077350269],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,1,2,3],"gami:faces_layer":[0,0,0,0]},{"frame_title":"A fresh square","gami:text":"Put the creased square aside and take a new one, so the next creases stand out.","gami:kind":"assemble","gami:section":"Trisecting an angle","vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[1]},{"frame_title":"An angle to trisect","gami:text":"Now something a straightedge and compass can’t do. Fold a line from the bottom left corner: here at 60° to the bottom edge, but any angle works.","gami:kind":"fold","vertices_coords":[[-0.5,0,0.5],[-1,0,-0.366025404],[-0.133974596,0,-0.866025404],[0.077350269,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[0,3,4]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[0.077350269,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it. We’ll split this angle into three equal parts.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[0.077350269,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[0,3,4]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[0.077350269,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Fold in half","gami:text":"Fold the bottom edge to the top edge.","gami:kind":"fold","vertices_coords":[[-0.5,0,-0.5],[0.5,0,-0.5],[0.5,0,0],[-0.211324865