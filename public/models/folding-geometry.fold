{"file_spec":1.2,"file_creator":"Gami","file_title":"Geometry by folding","file_classes":["diagrams"],"gami:id":"folding-geometry","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#c9b8f0"}],"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"A line through two points","gami:text":"Axiom 1: through any two points there is exactly one fold. Fold through two corners. Folding draws straight lines, like a ruler.","gami:kind":"fold","vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it again. Each fold leaves a crease, a straight line.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2],[0,3,1]],"gami:vertices_paper":[[-0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[0.5,0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"One point onto another","gami:text":"Axiom 2: there is exactly one fold that lays one point on another. Every point of the crease is the same distance from both: it’s the perpendicular bisector.","gami:kind":"fold","vertices_coords":[[0.5,0,0.5],[0,0,0],[0,0,-0.5],[0.5,0,-0.5],[0.5,0,-0.5],[0,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2,3],[1,4,2],[0,5,1],[5,6,4,1]],"gami:vertices_paper":[[-0.5,0.5],[0,0],[0,-0.5],[-0.5,-0.5],[0.5,-0.5],[0,0.5],[0.5,0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[1,0,1,0]},{"frame_title":"Unfold","gami:text":"Open it. The crease cuts the square exactly in half.","gami:kind":"unfold","vertices_coords":[[-0.5,0,0.5],[0,0,0],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,-0.5],[0,0,0.5],[0.5,0,0.5]],"faces_vertices":[[0,1,2,3],[1,4,2],[0,5,1],[5,6,4,1]],"gami:vertices_paper":[[-0.5,0.5],[0,0],