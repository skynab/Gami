{"file_spec":1.2,"file_creator":"Gami","file_title":"Dog face","file_classes":["diagrams"],"gami:id":"dog-face","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#a8703f"}],"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Turn it to a diamond","gami:text":"Start white side up, and turn the square so a corner points towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Bring the top corner down to the bottom corner, making a triangle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[0.5,-0.5]},{"paper":[-0.5,0.5]}]}},"vertices_coords":[[0.707106781,0,0],[0,0,0.707106781],[-0.707106781,0,0],[0,0,0.707106781]],"faces_vertices":[[0,1,2],[3,0,2]],"gami:vertices_paper":[[0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Crease the middle","gami:text":"Fold the left corner over to the right one, then unfold, leaving a crease down the middle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,-0.5]},{"paper":[0.5,0.5]}]}},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,0],[0.707106781,0,0],[0,0,0.707106781]],"faces_vertices":[[0,1,2],[3,0,2],[4,2,1],[4,3,2]],"gami:vertices_paper":[[0.5,-0.5],[-0.5,-0.5],[0,0],[0.5,0.5],[-0.5,0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[2,1,3,0]},{"frame_title":"Unfold","gami:text":"Open it back up, leaving a crease.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[0,0,0.707106781],[-0.707106781,0,0],[0,0,0],[0.707106781,0,0],[0,0,0.70