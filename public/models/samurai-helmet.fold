{"file_spec":1.2,"file_creator":"Gami","file_title":"Samurai helmet","file_classes":["diagrams"],"gami:id":"samurai-helmet","gami:sheet":{"size":[1,1],"front":"#3b5bd9","back":"#f6f3ec"},"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Turn it to a diamond","gami:text":"Turn the square so a corner points towards you.","gami:kind":"rotate","vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Bring the top corner down to the bottom corner, making a triangle.","gami:kind":"fold","vertices_coords":[[0.707106781,0,0],[0,0,0.707106781],[-0.707106781,0,0],[0,0,0.707106781]],"faces_vertices":[[0,1,2],[3,0,2]],"gami:vertices_paper":[[0.5,0.5],[0.5,-0.5],[-0.5,-0.5],[-0.5,0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Fold the left corner down","gami:text":"Bring the left corner down to the bottom point.","gami:kind":"fold","vertices_coords":[[-0.353553391,0,0.353553391],[0,0,0.707106781],[0,0,0],[0.707106781,0,0],[0,0,0.707106781],[-0.353553391,0,0.353553391],[0,0,0.707106781]],"faces_vertices":[[0,1,2],[3,4,0,2],[2,1,5],[6,3,2,5]],"gami:vertices_paper":[[0,-0.5],[-0.5,-0.5],[0,0],[0.5,0.5],[0.5,-0.5],[-0.5,0],[-0.5,0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[2,1,3,0]},{"frame_title":"Fold the right corner down","gami:text":"Bring the right corner down to match. Now it’s a diamond.","gami:kind":"fold","vertices_coords":[[-0.353553391,0,0.353553391],[0,0,0.707106781],[0,0,0],[0,0,0.707106781],[0.353553391,0,0.353553391],[0,0,0.707106781],[-0.353553391,0,0.353553391],[0.353553391,0,0.353553391],[0,0,0.707106781]],"faces_vertices":[[0,1,2],[3,4,2],[4,5,0,2],[2,1,6],[