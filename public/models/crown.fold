{"file_spec":1.2,"file_creator":"Gami","file_title":"Crown","file_classes":["diagrams"],"gami:id":"crown","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#e3a92b"}],"gami:about":{"blurb":"Three points and a band, from a triangle. A first fold fit for a king.","difficulty":1,"category":"object","minutes":3},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Start as a diamond","gami:text":"Start white side up, with a corner pointing towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Fold the bottom corner up onto the top corner, making a triangle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0.5]},{"paper":[0.5,-0.5]}]}},"vertices_coords":[[0,0,-0.707106781],[0.707106781,0,0],[-0.707106781,0,0],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[1,3,2]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Fold up the left point","gami:text":"Fold the left corner up so it points up and a little out to the left.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-0.05,0]},{"table":[-0.29944088369076355,-0.16667106990588065]}],"moving":{"table":[-0.6971067811865476,-0.005]}}},"vertices_coords":[[-0.05,0,0],[-0.301463878,0,-0.607087506],[-0.443906723,0,-0.263200058],[0,0,-0.707106781],[0.707106781,0,0],[-0.443906723,0,-0.263200058],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,4,0,2],[5,1,0],[4,6,5,0]],"gami:vertices_paper":[[-0.035355339,-0.035355339],[-0.5,-0.5],[-0.5,-0.1277