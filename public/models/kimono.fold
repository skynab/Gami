{"file_spec":1.2,"file_creator":"Gami","file_title":"Kimono","file_classes":["diagrams"],"gami:id":"kimono","gami:sheets":[{"size":[1,1],"front":"#f4efe4","back":"#b8344a"}],"gami:about":{"blurb":"A kimono with a white collar and its sleeves out at the shoulders, from one square.","difficulty":1,"category":"object","minutes":5},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Crease down the middle","gami:text":"Start with the plain side up. Fold the left edge to the right edge, and unfold.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"table":[-0.5,0]},{"table":[0.5,0]}]}},"vertices_coords":[[0.5,0,0.5],[0,0,0.5],[0,0,-0.5],[0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Unfold","gami:text":"Open it back up, leaving a crease.","gami:kind":"unfold","gami:op":{"op":"unfold"},"vertices_coords":[[-0.5,0,0.5],[0,0,0.5],[0,0,-0.5],[-0.5,0,-0.5],[0.5,0,0.5],[0.5,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2]],"gami:vertices_paper":[[-0.5,0.5],[0,0.5],[0,-0.5],[-0.5,-0.5],[0.5,0.5],[0.5,-0.5]],"gami:faces_parent":[0,1],"gami:faces_layer":[0,0]},{"frame_title":"Fold the sides in","gami:text":"Fold the left and right edges to the middle crease.","gami:kind":"fold","gami:op":{"op":"together","ops":[{"op":"fold","line":{"edgeOnto":[[{"table":[-0.5,-0.5]},{"table":[-0.5,0.5]}],[{"table":[0,-0.5]},{"table":[0,0.5]}]]}},{"op":"fold","line":{"edgeOnto":[[{"table":[0.5,-0.5]},{"table":[0.5,0.5]}],[{"table":[0,-0.5]},{"table":[0,0.5]}]]}}]},"vertices_coords":[[0,0,0.5],[-0.25,0,0.5],[-0.25,0,-0.5],[0,0,-0.5],[0,0,0.5],[0,0,-0.5],[0.25,0,0.5],[0,0,0.5],[0,0,-0.5],[0.25,0,-0.5]],"faces_vertices":[[0,1,2,3],[1,4,5,2],[6,7,8,9],[4,6