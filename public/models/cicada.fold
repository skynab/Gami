{"file_spec":1.2,"file_creator":"Gami","file_title":"Cicada","file_classes":["diagrams"],"gami:id":"cicada","gami:sheets":[{"size":[1,1],"front":"#f6f3ec","back":"#6a9a3a"}],"gami:about":{"blurb":"A traditional Japanese cicada, its wings folded out from a diamond.","difficulty":2,"category":"animal","minutes":5},"gami:ops":1,"vertices_coords":[[-0.5,0,0.5],[0.5,0,0.5],[0.5,0,-0.5],[-0.5,0,-0.5]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"file_frames":[{"frame_title":"Turn it to a diamond","gami:text":"Start white side up, and turn the square so a corner points towards you.","gami:kind":"rotate","gami:op":{"op":"rotate","degrees":45},"vertices_coords":[[0,0,0.707106781],[0.707106781,0,0],[0,0,-0.707106781],[-0.707106781,0,0]],"faces_vertices":[[0,1,2,3]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]],"gami:faces_parent":[0],"gami:faces_layer":[0]},{"frame_title":"Fold in half","gami:text":"Fold the bottom corner up to the top corner, making a triangle.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,0.5]},{"paper":[0.5,-0.5]}]}},"vertices_coords":[[0,0,-0.707106781],[0.707106781,0,0],[-0.707106781,0,0],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[1,3,2]],"gami:vertices_paper":[[-0.5,0.5],[0.5,0.5],[-0.5,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0],"gami:faces_layer":[1,0]},{"frame_title":"Fold the left corner up","gami:text":"Bring the left corner up to the top point.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[-0.5,-0.5]},{"table":[0,-0.7071067811865476]}]}},"vertices_coords":[[0,0,0],[0,0,-0.707106781],[-0.353553391,0,-0.353553391],[0,0,-0.707106781],[0.707106781,0,0],[-0.353553391,0,-0.353553391],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,4,0,2],[5,1,0],[4,6,5,0]],"gami:vertices_paper":[[0,0],[-0.5,-0.5],[-0.5,0],[-0.5,0.5],[0.5,0.5],[0,-0.5],[0.5,-0.5]],"gami:faces_parent":[0,0,1,1],"gami:faces_layer":[2,1,3,0]},{"frame_title":"Fold the right corner up","gami:text":"Bring the right corner up to match. Now it’s a diamond.","gami:kind":"fold","gami:op":{"op":"fold","line":{"onto":[{"paper":[0.5,0.5]},{"table":[0,-0.7071067811865476]}]}},"vertices_coords":[[0,0,0],[0,0,-0.707106781],[-0.353553391,0,-0.353553391],[0.353553391,0,-0.353553391],[0,0,-0.707106781],[0,0,-0.707106781],[-0.353553391,0,-0.353553391],[0.353553391,0,-0.353553391],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,4,0],[5,3,0,2],[6,1,0],[4,7,0],[7,8,6,0]],"gami:vertices_paper":[[0,0],[-0.5,-0.5],[-0.5,0],[0,0.5],[0.5,0.5],[-0.5,0.5],[0,-0.5],[0.5,0],[0.5,-0.5]],"gami:faces_parent":[0,1,1,2,3,3],"gami:faces_layer":[2,2,1,3,3,0]},{"frame_title":"Fold the flaps down","gami:text":"Fold the two flaps you just made back down, so their points meet the bottom point.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[-1,-0.3535533905932738]},{"table":[1,-0.3535533905932738]}],"moving":{"table":[0,-0.7071067811865476]}},"only":{"inPaper":[[[0,0],[-0.5,-0.5],[-0.5,0]],[[0,0.5],[0.5,0.5],[0,0]],[[0,-0.5],[-0.5,-0.5],[0,0]],[[0.5,0.5],[0.5,0],[0,0]]]}},"vertices_coords":[[0,0,-0.353553391],[0,0,0],[-0.353553391,0,-0.353553391],[0,0,0],[0.353553391,0,-0.353553391],[0,0,0],[0,0,-0.353553391],[0,0,-0.707106781],[-0.353553391,0,-0.353553391],[0.353553391,0,-0.353553391],[0,0,-0.707106781]],"faces_vertices":[[0,1,2],[3,0,2],[4,5,6],[4,6,3],[7,4,3,2],[8,1,0],[8,0,3],[5,9,6],[9,3,6],[9,10,8,3]],"gami:vertices_paper":[[-0.25,-0.25],[-0.5,-0.5],[-0.5,0],[0,0],[0,0.5],[0.5,0.5],[0.25,0.25],[-0.5,0.5],[0,-0.5],[0.5,0],[0.5,-0.5]],"gami:faces_parent":[0,0,1,1,2,3,3,4,4,5],"gami:faces_layer":[5,2,5,2,1,4,3,4,3,0]},{"frame_title":"Fold out the left wing","gami:text":"Fold the left flap’s point down and out at an angle, from the middle of the top edge.","gami:kind":"fold","gami:op":{"op":"fold","line":{"through":[{"table":[0,-0.3535533905932738]},{"table":[-0.16,-0.04]}],"moving":{"table":[0,-0.01]}},"only":{"inPaper":[[[-0.25,-0.25