# Accounts and the creator Studio use Supabase. Without these the site still works: learning needs no account.
# Find both in your Supabase project under Project Settings → API. See docs/accounts.md.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe Payment Links for the Donate dialog (Stripe dashboard → Payment Links). The Donate button stays
# hidden until at least one is set (it always shows under `npm run dev`).
# Tip: set each link's "After payment" redirect to https://<your-site>/?thanks
# so supporters land back on the site with a thank-you message.
VITE_DONATE_LINK_3=
VITE_DONATE_LINK_5=
VITE_DONATE_LINK_10=
# A Payment Link set to "Let customers choose what to pay".
VITE_DONATE_LINK_CUSTOM=
# Currency of the preset amounts above (display only).
VITE_DONATE_CURRENCY=USD
